{
    "tasks": [
        {
            "type": "shell",
            "label": "Build All (g++)",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-Wall",
                "-Wextra",
                "-g3",
                "main.cpp",
                "Centro.cpp",
                "RedCentros.cpp",
                "algoritmos\\NodoABB.cpp",
                "-I..\\include",
                "-o",
                "output\\main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\src"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compile all project .cpp files with g++"
        },
        {
            "type": "shell",
            "label": "Run main",
            "command": "${workspaceFolder}\\src\\output\\main.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Build and Run",
            "dependsOn": ["Build All (g++)", "Run main"],
            "dependsOrder": "sequence"
        }
    ],
    "version": "2.0.0"
}